{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": false,
    "forceConsistentCasingInFileNames": false
  },
  "include": [
    "src/test/setup.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "__tests__/**/*.test.tsx"
  ],
  "references": [{ "path": "./tsconfig.app.json" }]
}
