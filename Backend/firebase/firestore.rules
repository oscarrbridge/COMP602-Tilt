rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- USERS ---
    match /users/{uid} {
      // Public read (leaderboard)
      allow read: if true;

      // Owner can create & update their user doc
      allow create, update: if request.auth != null && request.auth.uid == uid;

      // No delete on user doc
      allow delete: if false;

      // Transactions subcollection
      match /transactions/{txId} {
        // Owner can read and create/update tx docs (no delete)
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid;
      }
    }

    // --- GAMES ---
    match /games/{gameId} {
      // Anyone can read games (so players can see lobbies)
      allow read: if true;

      // Any logged-in user can create/update games
      allow create, update: if request.auth != null;

      // No delete (optional: restrict to host later)
      allow delete: if false;

      // Players subcollection
      match /players/{playerId} {
        allow read: if true;
        // Only the player themself can write their entry
        allow create, update: if request.auth != null && request.auth.uid == playerId;
        allow delete: if false;
      }
    }

    // --- Everything else stays blocked ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
